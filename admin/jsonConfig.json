{
    "i18n": true,
    "type": "panel",
    "items": {
        "_connectionHeader": {
            "type": "header",
            "text": "Connection settings for the MX400",
            "size": 4,
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "ip": {
            "type": "text",
            "label": "IP address of the MX400 LAN and radio module",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "interval": {
            "type": "number",
            "label": "Polling interval (seconds)",
            "min": 10,
            "max": 3600,
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "token": {
            "type": "password",
            "label": "API token",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "_login": {
            "type": "text",
            "label": "Login of the MX400",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "_pass": {
            "type": "password",
            "label": "Pass of the MX400 (hyphens are removed automatically)",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "_getToken": {
            "type": "sendTo",
            "label": "Request API token",
            "command": "getToken",
            "variant": "contained",
            "useNative": true,
            "jsonData": "{\"ip\": \"${data.ip}\", \"login\": \"${data._login}\", \"pass\": \"${data._pass}\"}",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "_tokenHelpText": {
            "type": "staticText",
            "text": "To create the API token, enter the 'Login' and 'Pass' values from the sticker or information sheet of the MX400 (gateway firmware 15.00.01 or newer is required). Then press the WLAN and Wireless buttons on the MX400 at the same time for one second and click 'Request API token' within 5 minutes. The token appears in the field above, then save the settings. Login and Pass are not stored. The token does not expire, so treat it like a password. The manufacturer's guide explains the steps:",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "_tokenHelpLink": {
            "type": "staticLink",
            "label": "Manufacturer's guide: create an API token",
            "href": "https://github.com/bosch-home-comfort/api-docs/blob/main/docs/k-40-rf.md",
            "target": "_blank",
            "button": true,
            "variant": "outlined",
            "icon": "book",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "_rescanDivider": {
            "type": "divider",
            "newLine": true
        },
        "_rescanText": {
            "type": "staticText",
            "text": "At the start, the adapter remembers which resources your MX400 provides. It searches again once a day, or when you click this button. The search takes about one to two minutes.",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "_rescan": {
            "type": "sendTo",
            "label": "Search resources again",
            "command": "rescan",
            "variant": "outlined",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "_donateDivider": {
            "type": "divider",
            "newLine": true
        },
        "_donateText": {
            "type": "staticText",
            "text": "Do you like this adapter? You can support its development with a coffee donation.",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "_donateButton": {
            "type": "staticLink",
            "label": "Donate a coffee via PayPal",
            "href": "https://www.paypal.com/donate/?hosted_button_id=BW2WL8QCH2AMU",
            "target": "_blank",
            "button": true,
            "variant": "contained",
            "icon": "data:image/svg+xml;base64,",
            "controlStyle": {
                "backgroundColor": "#ffc439",
                "color": "#111111",
                "fontWeight": "bold",
                "textTransform": "none"
            },
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        }
    }
}
